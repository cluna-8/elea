# Overlay de entorno del ENTORNO DE EXAMEN (spec 035, T019; research R2).
#
# `*.env` está gitignored (deploy: "lo versionado son PLANTILLAS y ejemplos"), así que
# ESTE es el ejemplo versionado. Para renderizar/desplegar:
#     cp client.env.example client.env      # y branding.env.example → branding.env
#     ../../release/render_profile.sh itv-examen
# Nada de esto viaja a un cliente real: es el banco de pruebas de carga (La ITV).

# ── Identidad del perfil (obligatorio: TENANT_SLUG == nombre del dir) ──────────────────
TENANT_SLUG=itv-examen
BASE_DOMAIN=itv.internal          # dominio interno del examen (no público)
REGION=eu-central                 # residencia nominal (Hetzner, project guardian-itv)

# ── Cableado al STUB del harness (R2: los 3 puntos de egress, todos config) ────────────
# Punto 1 — model_list → stub: config.yaml.tmpl usa ${STUB_URL}/v1 con esta key dummy.
STUB_URL=http://generador.itv.internal:8080
STUB_API_KEY=stub-dummy-noop      # el stub la ignora; NO es un secreto

# Punto 2 — passthrough de suscripción Anthropic → stub. OJO: gateway.py lee
# BASA_GW_ANTHROPIC_BASE (default api.anthropic.com) pero compose.prod.yml NO lo pasa al
# backend (hallazgo R2). Este perfil lo cablea con compose.itv-examen.override.yml (ver
# README). Debe apuntar al MISMO host del stub que STUB_URL (sin /v1: el wire Anthropic
# vive en la raíz /v1/messages y el gateway le agrega el path).
BASA_GW_ANTHROPIC_BASE=http://generador.itv.internal:8080

# Punto 3 — provider keys VACÍAS A PROPÓSITO: un alias mal apuntado (a un proveedor real
# en vez del stub) falla RUIDOSO en lugar de gastar o fugar. NO las rellenes en el examen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# ── Licencia de test (R5) ─────────────────────────────────────────────────────────────
# La licencia ITV (300/500 seats, kid basa-dev-2026b) se emite in-house y se monta en
# /app/config/licenses/client.lic; este opt-in habilita el kid dev (SOLO dev/demo).
# Instalá la licencia definitiva ANTES de seedear (ampliar en caliente ≈5 min de 402).
BASA_ALLOW_DEV_LICENSE=true
BASA_DEPLOYMENT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Auditoría en modo cerrado: el examen mide bloqueos DURABLES (SLO d) — el registro es
# precondición, no best-effort. (audit_fail=closed rechaza tráfico si no puede auditar.)
BASA_AUDIT_FAIL=closed

# ── Imágenes PINNEADAS (compose.prod.yml las exige con ${VAR:?}) ──────────────────────
# El examen corre la imagen del stack REAL con el PR #97 (paridad NLP en /gw) — la
# definición del gate lo exige. Reemplazá por los digests publicados (publish.sh).
BACKEND_IMAGE=ghcr.io/basa/backend@sha256:REEMPLAZAR
FRONTEND_IMAGE=ghcr.io/basa/frontend@sha256:REEMPLAZAR
BASA_ENGINE_IMAGE=ghcr.io/basa/litellm@sha256:REEMPLAZAR
NLP_ANALYZER_IMAGE=ghcr.io/basa/nlp-analyzer@sha256:REEMPLAZAR
DOCS_IMAGE=ghcr.io/basa/docs@sha256:REEMPLAZAR
