# Branding del entorno de EXAMEN (spec 035, T019). No es un cliente real: el branding es
# nominal, sólo para que render_profile.sh produzca brand.json sin variables sin resolver.
#     cp branding.env.example branding.env
BRAND_NAME="Basa Guardian — Examen ITV"
BRAND_TAGLINE="Banco de pruebas de carga (La ITV). Entorno de examen, no producción."
BRAND_SUPPORT=harness@basa.internal
BRAND_COLOR_PRIMARY=#1f6feb
BRAND_COLOR_BACKGROUND=#0d1117
BRAND_COLOR_PANEL=#161b22
