# LiteLLM config del PILOTO ${TENANT_SLUG} — residencia ${REGION}.
# Bloque general/guardrails = EL MISMO de la 014 (paridad de política).
#
# Catálogo 0km del piloto: SOLO el modelo local (cero API keys, autocontenido —
# residencia total: nada sale de la VM). Los proveedores cloud de Cámara se
# agregan EN EL ALTA (runbook §modelos): una entrada acá + su key en secrets.env.
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  custom_auth: extensions.custom_auth.user_api_key_auth
  custom_auth_run_common_checks: true
guardrails:
- guardrail_name: basa-guardian
  litellm_params:
    guardrail: extensions.basa_guardrail.BasaGuardrail
    mode: [pre_call, post_call]
    default_on: true
litellm_settings:
  callbacks: extensions.basa_audit_logger.basa_audit_logger_instance
  cache: false          # piloto: cache OFF — incompatible con masking reversible (issue #30)
  drop_params: true
  set_verbose: false
model_list:
# `max_parallel_requests` (issue #151, decisión técnica del #134): el SEGUNDO candado del
# nodo C1, del lado del motor. El primero es el tope de admisión del backend (8 en vuelo ×
# 2 workers = 16 total); éste está para que la cola infinita no vuelva a existir NI AUNQUE
# el backend falle en cortarla, porque el runtime local de la sede serializa las
# generaciones y encola FIFO sin límite — ahí empezó el cuelgue del 30-jul, con el producto
# entero mudo ~10 min por culpa de un chat lento. 20 = tope total del backend + margen, a
# propósito POR ENCIMA: el que rechaza tiene que ser el backend, con su 503 honesto y
# auditado, no el motor con un error opaco que nadie audita.
#
# `num_retries: 0` (issue #151, decisión #134-② sellada por JF el 12-ago): el candado más
# barato de los tres. El `num_retries: 2` de `router_settings` es sano contra un proveedor
# cloud, pero contra el runtime local —que serializa y encola FIFO— es amplificación pura:
# cada generación que expira vuelve a la MISMA cola dos veces más (×3 trabajo por pedido)
# justo cuando el sistema ya no da abasto. Parte del diagnóstico del 30-jul. El valor por
# deployment pisa al global SÓLO para este upstream; el cloud que se dé de alta por el panel
# conserva sus 2 reintentos. Y no apaga los fallbacks: son otra capa (ver ADR-0003).
- litellm_params:
    api_base: http://${CLIENT_OLLAMA_HOST}:11434
    max_parallel_requests: 20
    model: ollama_chat/${CLIENT_OLLAMA_MODEL}
    num_retries: 0
  model_name: ${TENANT_SLUG}-local
# ^ El ALIAS es estable (las rutas del auto-router y la UI lo referencian); el modelo
#   REAL de Ollama debajo es CLIENT_OLLAMA_MODEL en client.env — si la sede tiene otro
#   (`ollama list`), se cambia UNA línea y se re-renderiza, o se registra por UI (§5
#   del INSTALL) y se repuntan las rutas en el panel «Ruteo inteligente» (2 clics, caliente).
# Embeddings del auto-router semántico (spec 030 R1): qwen3-embedding:0.6b LOCAL — el
# contenido del prompt NO sale de la VM para decidir el ruteo (FR-003 + residencia).
# ollama/ (no ollama_chat/): el endpoint es /v1/embeddings, no /api/chat.
# NO es un modelo conversable: se excluye del dropdown del chat por nombre.
# PRERREQUISITO DE SEDE: `ollama pull qwen3-embedding:0.6b` (639 MB) en el host del
# runtime. Si falta, el ruteo degrada al default_model y lo REGISTRA (FR-004) — el
# chat sigue funcionando.
- litellm_params:
    api_base: http://${CLIENT_OLLAMA_HOST}:11434
    model: ollama/qwen3-embedding:0.6b
  model_info:
    input_cost_per_token: 0
    mode: embedding
    output_cost_per_token: 0
  model_name: router-embeddings
# Base de router (spec 030 R8): sin este bloque el alta de un modelo cloud por el panel
# no tiene dónde escribir su fallback al local. Los `fallbacks` NO se siembran acá — los
# escribe el alta (cloud→local por defecto; local→cloud está prohibido: violaría la
# residencia que motiva el modelo local).
router_settings:
  disable_cooldowns: true
  num_retries: 2
  timeout: 120   # generación local (qwen con thinking) supera 30s en respuestas largas — hallazgo T018
