# LiteLLM config TEMPLADO por cliente (spec 020 US3, FR-011): model_list,
# proveedores y región se inyectan POR CLIENTE al renderizar — jamás horneados
# en la imagen. Las keys de proveedor son os.environ/* : el VALOR llega del
# store de secretos de la instalación (US5), nunca de este archivo.
# El bloque general/guardrails es EL MISMO de la 014 (paridad de política).
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  custom_auth: extensions.custom_auth.user_api_key_auth
  custom_auth_run_common_checks: true
guardrails:
- guardrail_name: basa-guardian
  litellm_params:
    guardrail: extensions.basa_guardrail.BasaGuardrail
    mode: [pre_call, post_call]
    default_on: true
litellm_settings:
  callbacks: extensions.basa_audit_logger.basa_audit_logger_instance
  cache: true
  cache_params:
    host: os.environ/REDIS_HOST
    port: 6379
    ttl: 3600
    type: redis
  drop_params: true
  set_verbose: false
model_list:
# Modelos habilitados para ${TENANT_SLUG} — residencia ${REGION}.
- litellm_params:
    api_base: os.environ/AZURE_API_BASE
    api_key: os.environ/AZURE_API_KEY
    api_version: os.environ/AZURE_API_VERSION
    model: azure/${CLIENT_AZURE_DEPLOYMENT}
  model_name: ${TENANT_SLUG}-gpt-4o
