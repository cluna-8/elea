# Imagen de producción del panel — build estático servido por nginx, con proxy reverso
# hacia el backend (el SPA de prod llama /api/v1 y /gw en el MISMO origen, ver
# vite.config.ts). Build DESDE frontend/ (contexto normal, no necesita ver otras carpetas).
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
