# Entorno de la extensión `sentinel/` para DESARROLLO (spec 057 T021). Se copia a
# sentinel/extensions.env (ignorado por git) y se usa con sentinel/docker/compose.dev.yml —ver su
# cabecera—. SIN secretos: lo que dice <generar> lo generás vos y no se versiona. En producción este
# archivo vive solo en el servidor (modo 600, fuera del repo) y llega por EXTRA_ENV_FILE (S12).
#
# Apagado por defecto: borrar GATEWAY_PLUGINS y PLUGIN_PACKAGES deja backend y motor como la base.

# ── backend: costuras de la base (S2, S1, S4) ──────────────────────────────────────────────────────
GATEWAY_PLUGINS=sentinel.redirect.plugin
PLUGIN_PACKAGES=sentinel.redirect.api,sentinel.catalog.api
ALEMBIC_EXTRA_VERSION_LOCATIONS=/opt/sentinel-ext/sentinel/migrations

# ── backend y motor: autorización interna pasarela→motor ───────────────────────────────────────────
# Dedicada, ≥ 32 caracteres: openssl rand -base64 48
REDIRECT_INTERNAL_KEY=<generar>

# ── backend y motor: marcadores de enmascarado estables por conversación (caché del proveedor; S13) ───
# Clave del servidor, ≥ 32 caracteres, DISTINTA de las demás y propia de esta instalación: openssl rand -hex 32. De ella se
# derivan el sufijo de los marcadores, la referencia de conversación y el identificador de afinidad de sesión. Nunca se
# referencia como credencial de un modelo. Sin ella (o más corta) los marcadores son aleatorios y la caché rinde menos.
MASKING_NONCE_KEY=<generar>

# ── región de la instalación (perfil Argentina) y seeds de arranque ────────────────────────────────
# El `environment:` de la base la fija con `${SENTINEL_ENTITY_REGION:-eu}`: solo cambia con --env-file.
SENTINEL_ENTITY_REGION=latam_ar
# Archivos de región y de habilitación que la extensión carga al arrancar (costura S16: idempotente, antes de servir),
# separados por coma, vistos por el backend en /opt/sentinel-ext/seeds (compose.dev.yml). Sin la fila de región rige el
# respaldo en código —todo lo redirigido sale enmascarado y solo a la región— y GET /api/v1/redirect/health da 503.
# El seed solo CREA: lo que cambió un administrador (p. ej. la postura por defecto de la región) no se pisa al reiniciar.
REDIRECT_SEED_FILES=/opt/sentinel-ext/seeds/regions.americas.yaml,/opt/sentinel-ext/seeds/habilitacion-explicita.yaml

# ── credenciales de destinos de NIVEL INSTALACIÓN (motor): una por destino, `env:REDIRECT_CRED_<X>` ──
# REDIRECT_CRED_<NOMBRE>=<secreto del proveedor>

# ── opcionales ──────────────────────────────────────────────────────────────────────────────────────
# TTL de la caché de política en segundos (default 5)
# REDIRECT_CACHE_TTL_S=5
# Presupuesto propio de cada prueba de fidelidad en USD (default 0.50)
# REDIRECT_FIDELITY_BUDGET_USD=0.50
# Dirección pública de la pasarela que llevan los kits de cliente (default: la de la petición)
# REDIRECT_GATEWAY_URL=http://localhost:8091/api/v1/gw
# Modelos locales on-prem de una empresa (http o una dirección de la red interna, p. ej. un servidor de modelos propio):
# apagado por defecto, el administrador de una empresa solo carga https a un host público. Solo para instalaciones de un
# solo tenant; los metadatos de nube y los esquemas que no son http(s) se rechazan igual.
# CATALOG_ALLOW_PRIVATE_API_BASE=false
# Rotación de la clave de cifrado de credenciales (la anterior SOLO descifra)
# FERNET_PREVIOUS_KEYS=<clave anterior>
