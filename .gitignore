# `.claude/*` y no `.claude/`: git no entra en un directorio ignorado, así que la
# excepción de abajo sólo funciona si el patrón lista el contenido.
.claude/*
# Los subagentes del repo SÍ se comparten con el equipo (Claude Code los carga
# desde esta ruta); el resto de .claude/ es configuración personal.
!.claude/agents/

# spec 021: claves privadas del emisor dev de licencias — NUNCA commitear
backend/scripts/license_out/

# 022: build output del sitio de docs
docs/site/
docs/.cache/

# binarios vendorizados para el bundle air-gapped (no van a git)
deploy/release/vendor/
docker-compose.override.yml
