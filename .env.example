# Basa Guardian - Environment Variables

# Database Configuration
POSTGRES_DB=basa_gateway
POSTGRES_USER=basa_admin
POSTGRES_PASSWORD=basasecurepass123

# Backend secrets (OBLIGATORIOS - generar valores propios, no dejar vacíos)
#   JWT_SECRET_KEY:    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   FERNET_SECRET_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=
FERNET_SECRET_KEY=

# LiteLLM Configuration
LITELLM_MASTER_KEY=basa_master_key_9999

# LLM API Keys (agregar las de los providers que uses; sin key real NO hay
# respuesta LLM - el sistema es fail-closed, no existe modo simulado)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=
# Azure OpenAI (el compose las mapea a AZURE_API_KEY/AZURE_API_BASE del motor)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=

# Licencia offline (spec 021) - enforcement FAIL-CLOSED: sin token valido no se
# crean Connections/Clients nuevos (el trafico existente sigue). En dev/demo el
# compose apunta por default a la licencia dev del repo; en un deploy real la
# 020 inyecta el .lic del cliente como secret.
# BASA_LICENSE_TOKEN_FILE=/app/config/licenses/dev-demo.lic
# BASA_LICENSE_TOKEN=            # alternativa: el .lic inline (JSON)
# BASA_LICENSE_PUBLIC_KEYS_FILE= # default: src/keys/basa_public_keys.pem (embebido)
# BASA_DEPLOYMENT_TENANT_ID=     # tenant del deployment; default: tenant seed 013
# BASA_ALLOW_DEV_LICENSE=true    # opt-in a claves dev (kid basa-dev-*); SOLO dev/demo
