# Basa Guardian - Environment Variables

# Database Configuration
POSTGRES_DB=basa_gateway
POSTGRES_USER=basa_admin
POSTGRES_PASSWORD=basasecurepass123

# Backend secrets (OBLIGATORIOS - generar valores propios, no dejar vacíos)
#   JWT_SECRET_KEY:    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   FERNET_SECRET_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=
FERNET_SECRET_KEY=

# LiteLLM Configuration
LITELLM_MASTER_KEY=basa_master_key_9999

# LLM API Keys (agregar las de los providers que uses; sin key real NO hay
# respuesta LLM - el sistema es fail-closed, no existe modo simulado)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=
# Azure OpenAI (el compose las mapea a AZURE_API_KEY/AZURE_API_BASE del motor)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=
