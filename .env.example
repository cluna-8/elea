# Sentinel Guardian - Environment Variables

# Database Configuration
POSTGRES_DB=sentinel_gateway
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinelsecurepass123

# Nombre de la base PROPIA del motor del gateway (default `sentinel_engine`), dentro del mismo Postgres. Tiene que ser distinta de POSTGRES_DB: el migrador del motor borra toda tabla ajena de la base a la que apunta. La crea un servicio de un solo disparo en desarrollo y el script de inicialización de la base en producción; el script de respaldo copia las dos bases en una sola copia.
ENGINE_DB=sentinel_engine

# ── Conexión a la base de datos y Redis (producción) ─────────────────────────────────
# En producción la base y el Redis son gestionados/externos: el compose de prod NO los
# levanta — los alcanza por red. Por eso el host es un dato que el operador TIENE que dar,
# no un default que se puede dejar vacío. El compose de prod lo declara con `:?` (sin
# default): si falta, el stack no levanta y lo dice — no arranca contra un host inventado.
# El puerto SÍ tiene default (5432), pero se declara explícito porque entra en el DATABASE_URL
# que arma el motor del gateway: los dos planos tienen que resolver el mismo endpoint.

# Host de la base de datos (Postgres). OBLIGATORIO en producción: el compose de prod lo
# pasa con `:?`, sin default — si la variable no llega, el stack no arranca. En dev la
# levanta el compose (servicio `db`), así que no hace falta declararla; en prod es el host
# de la instancia gestionada por el cliente.
POSTGRES_HOST=

# Puerto de la base de datos. Default `5432` (el compose de prod lo declara con `:-5432`).
# Se declara explícito porque el motor del gateway arma su `DATABASE_URL` con este valor:
# si el backend y el motor no resuelven el mismo puerto, uno conecta y el otro no.
POSTGRES_PORT=5432

# Host de Redis. OBLIGATORIO en producción: el compose de prod lo pasa con `:?`, sin
# default. Lo usan DOS servicios (backend y motor del gateway) — los dos escriben y leen
# las mismas claves (`sentinel:audit:*`, `sentinel:nlp:*`); apuntar a instancias distintas hace que
# el health cuente cero mientras el otro plano registra. En dev lo levanta el compose; en
# prod es el host de la instancia gestionada por el cliente.
REDIS_HOST=

# Puerto de Redis. Default `6379` (el compose de prod lo declara con `:-6379`). Se declara
# explícito por la misma razón que POSTGRES_PORT: backend y motor tienen que resolver el
# MISMO endpoint.
REDIS_PORT=6379

# Migraciones de extensiones: directorios alembic extra (separados por coma o `:`) que se
# suman al árbol del core. Vacío (el default) = sólo las migraciones del core y el arranque
# migra a `head` como siempre. Con valor, cada directorio es una rama propia y el arranque
# migra a `heads`. Un directorio declarado que no existe hace FALLAR la migración.
ALEMBIC_EXTRA_VERSION_LOCATIONS=

# Backend secrets (OBLIGATORIOS - generar valores propios, no dejar vacíos)
#   JWT_SECRET_KEY:    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   FERNET_SECRET_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=
FERNET_SECRET_KEY=

# Rotación de FERNET_SECRET_KEY: claves anteriores, separadas por coma. SOLO descifran: lo
# nuevo se cifra siempre con FERNET_SECRET_KEY y lo ya cifrado con una clave anterior sigue
# legible. Vacío (el default) = una sola clave, sin cambio de comportamiento. Una clave con
# formato inválido se ignora con un aviso en el log.
FERNET_PREVIOUS_KEYS=

# Hilos del executor dedicado de bcrypt del LOGIN (#167). bcrypt es CPU-bound y lento a
# propósito; una ráfaga de logins corriendo en el threadpool anyio compartido le comía los
# hilos al gateway (auditoría/rechazo por run_in_threadpool) y disparaba el fail-closed del
# NLP sobre tráfico legítimo. Este executor ACOTADO y SEPARADO lo evita. Es POR PROCESO: el
# total de la instalación es el valor por WEB_CONCURRENCY. Vacío = default min(cpu, 4) (bcrypt
# libera el GIL, pero más hilos que CPUs sólo agrega contención; el techo es 4). Un valor
# ausente/vacío/malformado/fuera de rango cae al default — un typo no debe voltear el login.
SENTINEL_BCRYPT_WORKERS=

# Configuración del motor del gateway
SENTINEL_ENGINE_MASTER_KEY=sentinel_master_key_9999

# Segunda capa del plano interno (/api/v1/internal/*, el que usa el motor para resolver identidad y auditar): además del secreto compartido, sólo acepta conexiones cuyo origen esté en esta lista de redes CIDR separadas por coma (ej. 172.18.0.0/16,10.0.0.0/8). `auto` toma la subred de la red de compose a la que está enchufado el backend (el default de los dos compose). Vacía, no chequea el origen (queda sólo el secreto). Una entrada mal escrita cierra el plano en vez de abrirlo.
INTERNAL_ALLOWED_CIDRS=auto

# ── Admisión hacia el motor de IA: el tope que protege al producto ENTERO (nodo C1) ──
# Un pico de generaciones lentas no puede llevarse puesto el login, el health ni el panel.
# El backend admite hasta N pedidos EN VUELO hacia el motor y al resto lo rechaza rápido
# —503 honesto, auditado y con cabecera `X-Sentinel-Rejected: saturated`— en vez de encolarlo
# reteniendo una conexión de Postgres mientras espera. Todas las perillas de este bloque
# son POR PROCESO: el total de la instalación es el valor × WEB_CONCURRENCY (los workers
# no comparten memoria, así que tampoco comparten el semáforo).
# Un valor ausente, vacío, malformado o FUERA DE RANGO nunca tumba el arranque: se loguea
# un warning y se usa el default. Fuente de los rangos: backend/src/services/engine_gate.py.

# Pedidos en vuelo hacia el motor por proceso — la perilla del TOPE. Rango válido: 1..64
# (fuera de ahí se ignora con warning). Cada pedido admitido retiene una conexión del pool
# (30 por proceso): con 8 quedan ~22 libres para login, admin y health. Un tope demasiado
# alto no es "más capacidad", es volver a no tener tope.
# ⚠ SI SUBÍS ESTA PERILLA, SUBÍ TAMBIÉN el `max_parallel_requests` del deployment local en el
# catálogo del motor. Invariante: max_parallel_requests > SENTINEL_ENGINE_MAX_CONCURRENCY ×
# WEB_CONCURRENCY (hoy 20 > 8 × 2 = 16). Si se invierte, el primero en rechazar pasa a ser el
# motor —error opaco, sin cabecera `X-Sentinel-Rejected` y sin fila auditada— en vez del backend,
# y saturar deja de verse. Nada lo verifica en runtime: es tuya al girar el tope.
SENTINEL_ENGINE_MAX_CONCURRENCY=8

# Cuánto espera su turno un pedido antes de que se lo rechace, en segundos — la perilla de
# la PACIENCIA. Rango válido: 0 < v <= 60 (un queue-timeout de 600 s es la cola infinita
# con otro nombre). El `Retry-After` del 503 se deriva de este valor, no es un 5 fijo.
SENTINEL_ENGINE_QUEUE_TIMEOUT_SECONDS=5

# Timeout de la llamada al motor desde el CHAT de la consola, en segundos. Rango válido:
# 0 < v <= 600. Es una UI con una persona esperando, por eso el default es corto; el perfil
# de producción lo sube a 150 para no cortar antes que el router del motor (120 s con
# modelos locales lentos), que sería abortar una respuesta buena y ya pagada.
SENTINEL_ENGINE_TIMEOUT_SECONDS=60

# Timeout TOTAL de una llamada BYOK no-streaming de /gw (herramientas de código), en
# segundos. Rango válido: 0 < v <= 600. Perilla PROPIA y no la del chat a propósito: una
# coding tool tolera —y necesita— generaciones largas. Regla al girarla: el que ESPERA
# tiene que aguantar más que el que TRABAJA (el router del motor espera 120 s).
SENTINEL_GW_BYOK_TIMEOUT_SECONDS=150

# Timeout ENTRE CHUNKS del streaming BYOK de /gw, en segundos. Rango válido: 0 < v <= 600.
# El modelo local no manda pings mientras piensa: con un valor bajo la conexión se corta
# sola en mitad de una respuesta buena. Misma regla que el anterior.
SENTINEL_GW_BYOK_READ_TIMEOUT_SECONDS=150

# ── Purga de retención: que el día 91 pase de verdad ─────────────────────────────────
# La retención ya no es sólo una DECLARACIÓN: el DPO fija los plazos, la pantalla los muestra,
# el DPA los promete — y desde spec 018 (US1) hay un proceso que ELIMINA las filas vencidas de
# cada clase. Estas perillas lo configuran. Viene APAGADO por defecto (ver SENTINEL_PURGE_ENABLED):
# encenderlo es un acto explícito del operador. Las de la corrida se giran SIN reinstalar (se
# releen en cada corrida); la excepción es el interruptor maestro, que se lee al arrancar y por
# eso pide reinicio del backend.
#
# QUÉ ESTÁ PROTEGIDO Y QUÉ NO
# Los registros de la licencia —los que la caja escribe sola cada vez que la licencia se
# carga, entra en gracia o caduca— no se borran nunca, y ninguna perilla de esta lista los
# puede borrar. Lo que los protege es el SELLO que la propia caja deja escrito DENTRO de
# cada uno de esos registros; no los protege el nombre que figure en la columna «modelo».
# Todos los registros de licencia que la caja escribió alguna vez llevan ese sello, también
# los de instalaciones antiguas.
# Lo que NO está protegido: un pedido cualquiera puede declarar que su modelo se llama
# «license» —el nombre del modelo lo elige quien manda el pedido— y ese registro no lleva
# sello, así que es tráfico normal y se borrará cuando le toque por su plazo. Es a propósito:
# si bastara con llamarse «license» para no borrarse nunca, cualquiera con una clave de API
# se compraría un registro inmortal con sólo pedirlo así, que es justo lo que la retención
# viene a impedir.
#
# ⚠ ESTADO EN ESTA ENTREGA: el proceso que lee estas perillas —el que borra— YA viaja
# (spec 018 US1: purgador + scheduler cableados en el arranque del backend). Con
# SENTINEL_PURGE_ENABLED=false (el default) el scheduler ni arranca y no se borra ninguna fila,
# así que la caja sale configurada pero inerte. Ponerlo en `true` (con reinicio del backend)
# enciende la purga; hacerlo con SENTINEL_PURGE_DRY_RUN=true (el default) hace una corrida que
# CUENTA sin borrar, para que el DPO firme sobre el número antes del borrado real.

# Interruptor maestro del borrado por retención. En `false` (el default) el scheduler de purga
# ni arranca y no se elimina ninguna fila: la instalación queda configurada pero inerte. En
# `true` (con reinicio del backend — se lee al arrancar, no en caliente) el proceso arranca y,
# salvo simulacro (SENTINEL_PURGE_DRY_RUN), borra las filas vencidas de cada clase. Es la primera
# de la doble compuerta: el scheduler exige además un intervalo > 0. Viene APAGADO, y eso es
# una decisión, no un olvido: un proceso que borra hacia atrás no se enciende solo con una
# actualización de producto. La primera vez que arranque se encontraría con todo lo acumulado
# en la vida de la instalación y se lo llevaría de una — y lo borrado no vuelve. Encenderlo
# será un paso EXPLÍCITO del runbook, con reinicio del backend (se lee al arrancar, no en
# caliente) y después de haber leído el conteo del simulacro. La tensión con el Art. 5.1.e es
# real y está aceptada: una retención que todavía no borra se arregla con un `true`; un
# borrado que se encendió solo y se llevó de más no se arregla con nada. Se apaga también, ya
# en operación, para una instalación con un legal hold en curso.
SENTINEL_PURGE_ENABLED=false

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). ¿Simulacro? En `true` la corrida
# hará todo menos borrar: resuelve la fecha de corte, CUENTA las filas que caerían y deja el
# rastro marcado como simulacro. Nada se elimina. Es la segunda mitad de la red del encendido:
# aun con el interruptor en `true`, la instalación cuenta antes de borrar, y el DPO firma
# sobre un número real —«se van 412.000 filas de esta clase, con esta fecha de corte»— en vez
# de enterarse del alcance leyendo el rastro de lo ya borrado. Se pasa a `false` recién cuando
# ese número está mirado y aceptado, y es el único cambio de esta lista que hay que hacer una
# sola vez y con alguien mirando.
SENTINEL_PURGE_DRY_RUN=true

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). Cada cuánto DESPIERTA el proceso a
# mirar si está en ventana, en segundos. No es «cada cuánto borra»: si el momento cae fuera de
# SENTINEL_PURGE_WINDOW no hace nada y se vuelve a dormir. Bajarlo no borra más rápido, sólo
# engancha la ventana antes.
SENTINEL_PURGE_INTERVAL_SECONDS=3600

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). Ventana horaria en la que se
# permitirá borrar, `HH:MM-HH:MM` en la hora local de la instalación (ver
# SENTINEL_PURGE_WINDOW_TZ). El registro de auditoría es la tabla más caliente del producto —con
# el monitor, la analítica, los costes y el export leyendo encima— y el borrado compite con
# esos lectores: se trabaja de madrugada para que nadie note que existe. Una ventana que cruza
# medianoche (`23:00-02:00`) es válida.
SENTINEL_PURGE_WINDOW=02:00-05:00

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). Zona horaria (nombre IANA) con la
# que se interpreta SENTINEL_PURGE_WINDOW. El contenedor corre en UTC: sin esto, «las 02:00»
# serían las 04:00 de la sede en verano y las 23:00 del día anterior en una instalación de
# LATAM — o sea, borrando en hora punta.
SENTINEL_PURGE_WINDOW_TZ=Europe/Madrid

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). Filas por lote. Lo acumulado en la
# primera corrida puede ser de meses de tráfico: borrar millones de filas de un golpe bloquea
# la tabla un rato largo y le tumba la pantalla al officer. Se converge por lotes.
SENTINEL_PURGE_BATCH_SIZE=5000

# Sólo surte efecto con SENTINEL_PURGE_ENABLED=true (ver arriba). Pausa entre lotes, en
# milisegundos: le devuelve la tabla a los lectores calientes entre lote y lote. Es la perilla
# de CORTESÍA — se sube si la instalación acusa el borrado; bajarla a 0 lo convierte en el
# vecino ruidoso de su propia tabla.
SENTINEL_PURGE_BATCH_PAUSE_MS=200

# Motor de detección NLP real (spec 016) — servicio interno, sin necesidad de key.
# Default correcto para docker compose (nombre de servicio); no tocar salvo despliegue custom.
NLP_ANALYZER_URL=http://nlp-analyzer:3000
# Set de patrones estructurados a usar (DNI/pasaporte/etc.) — "eu" por default. Es el
# default DE ARRANQUE de la instalación (lo leen el motor Y el backend — gobierna
# byok, /gw, la extensión de navegador y el Playground), NO la fuente canónica: cada
# tenant puede fijar su propia región en `pii_masking.config.region` (spec 016,
# issues 137/141) y esa la pisa. Cambiar acá sólo mueve el default para tenants que
# todavía no tienen la clave propia — un despliegue latam_ar recién instalado, p.ej.
SENTINEL_ENTITY_REGION=latam_ar

# Bóveda persistente de PII (opt-in, decisión de Elea 02-sep): sin esto el RAG
# documental nunca puede restaurar el dato real en la respuesta (el enmascarado ocurre
# en la subida del documento, un request aparte del chat que lo consulta después) — el
# chat directo SÍ desenmascara sin esto porque mask+unmask pasan en el MISMO request.
# Guarda ph_to_orig en Redis con TTL, consultado solo al desenmascarar. Default del
# módulo compartido es `false` (Constraint C1) — acá se prende a propósito para Elea.
SENTINEL_PII_VAULT_ENABLED=true
SENTINEL_PII_VAULT_TTL_SECONDS=7776000

# Extensiones del backend (plugins): paquetes Python externos que agregan endpoints sin
# tocar el core. Vacío (el default) = no se carga nada y la API es exactamente la del core.
# Módulos importables separados por coma; cada uno expone
# `get_routers() -> list[tuple[APIRouter, str]]` (router, prefix). Un plugin declarado que no
# importa o no cumple el contrato hace FALLAR el arranque (no se sirve una API a medias).
# Un módulo puede exponer además `on_startup()` (síncrona o `async`, opcional): se llama una vez por
# proceso, en el orden de esta lista, antes de servir el primer pedido (p. ej. para sembrar datos de
# forma idempotente). Un fallo se registra con el nombre del módulo y no tira el arranque.
PLUGIN_PACKAGES=

# Plugins del gateway: módulos Python importables, separados por coma, que se suman al camino
# de las peticiones del gateway (cada módulo expone `gateway_plugin`). Vacío (el default) = no
# se carga ninguno y el gateway se comporta exactamente como el del core.
GATEWAY_PLUGINS=

# LLM API Keys (agregar las de los providers que uses; sin key real NO hay
# respuesta LLM - el sistema es fail-closed, no existe modo simulado)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=
# Azure OpenAI (el compose las mapea a AZURE_API_KEY/AZURE_API_BASE del motor)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_API_VERSION=

# ── SSO: entrar con la identidad corporativa del cliente (spec 017 US2) ──────────────
# Estas dos perillas son del DESPLIEGUE. Los tres datos del CLIENTE (Directory ID,
# Application ID y el secreto del directorio) no viven acá: van en la base, una fila por
# tenant, con el secreto cifrado con FERNET_SECRET_KEY. El SSO además exige que la
# licencia lo habilite; el acceso con usuario y contraseña sigue disponible siempre, y
# eso es permanente, no un provisorio. La operatoria completa —el registro en el
# directorio del cliente y sus trampas— está en la
# [guía de instalación de SSO](../install-deploy/sso.md).

# URI de retorno del SSO. Apunta a la ruta de la CONSOLA, no a un endpoint de la API: el
# directorio redirige un NAVEGADOR, y es la consola la que canjea el código por la sesión
# con una llamada aparte, para que la sesión nunca viaje en la URL. Es OBLIGATORIA y
# EXPLÍCITA: sin valor el camino SSO corta con sso_redirect_uri_no_configurado y el login
# local sigue andando. Deducirla de la petición entrante la haría manipulable por
# cabecera. Tiene que ser la misma que se registró en el directorio del cliente, byte a
# byte —la barra final cuenta—, porque el mismo valor se usa al pedir el código y al
# canjearlo.
SENTINEL_SSO_REDIRECT_URI=

# SOLO desarrollo sobre HTTP plano: en 1, true o yes la cookie del flujo SSO viaja sin el
# atributo Secure. Vacía o ausente —el default— la cookie es Secure: en duda, no viaja en
# texto claro. En producción se deja vacía.
SENTINEL_SSO_COOKIE_INSECURE=

# ── Licencia offline (spec 021) ──────────────────────────────────────────────────────
# Enforcement FAIL-CLOSED: sin token válido no se crean Connections/Clients nuevos
# (el tráfico existente sigue). En dev/demo el compose apunta por default a la
# licencia dev del repo; en un deploy real la 020 inyecta el .lic del cliente.

# Ruta al .lic DENTRO del contenedor. El bundle de producción ya la fija
# (/app/config/licenses/client.lic) y el compose de dev/demo trae su propio default, así
# que esta variable es para despliegues que arman su propio compose. Vacía = el default
# del compose.
SENTINEL_LICENSE_TOKEN_FILE=
# Alternativa a la anterior: el contenido del .lic inline (JSON). Cuando trae contenido el
# backend la prefiere sobre SENTINEL_LICENSE_TOKEN_FILE. Ninguno de los dos composes que se
# shipean la pasa al contenedor: es para despliegues que inyectan el env por su cuenta.
SENTINEL_LICENSE_TOKEN=
# SENTINEL_LICENSE_PUBLIC_KEYS_FILE= # default: src/keys/sentinel_public_keys.pem (embebido)
# SENTINEL_DEPLOYMENT_TENANT_ID=     # tenant del deployment; default: tenant seed 013
# SENTINEL_ALLOW_DEV_LICENSE=true    # opt-in a claves dev (kid sentinel-dev-*); SOLO dev/demo

# ── Cliente RAG de Elea (perfil `rag`, spec 040) ──────────────────────────────────────
# Ver client/README.md para cómo generar cada valor.

# ELEA_SERVICE_USERNAME/ELEA_SERVICE_PASSWORD: quitadas (09-sep) — server.js ya no las lee
# desde que el presupuesto pasó a autoservicio (sesión propia de cada persona, no una
# cuenta de admin de fondo); habían quedado declaradas acá sin que ningún plano las
# consumiera.

# API key de la instancia de AnythingLLM (se genera una vez, no la de ejemplo del código
# heredado — esa estaba filtrada en texto plano).
ANYTHINGLLM_API_KEY=

# ── Eleia Hub y motores (perfiles `rag`, `tabular`, `presentations`) ───────────────────
# Guardian es firewall + base de usuarios; el Hub es un conector; cada motor corre en su contenedor, sin puertos, y sale a los modelos únicamente por `engine:4000/v1` con su propia llave `svc.*`. La llave maestra del motor (`SENTINEL_ENGINE_MASTER_KEY`) no va nunca a un motor: saltea tenant, presupuesto y auditoría. El motor de planillas lleva el historial por hilo con valores por defecto de 5 turnos visibles al modelo, un resumen acumulado cada 5 turnos viejos y 50 filas de resultado guardadas por turno (las que usa "Crear presentación" desde el historial). El Hub publica la pantalla de administración de plantillas de presentaciones en el puerto 8097, solo para admins con sesión. En instalaciones con motores de generación el compose fija `SENTINEL_NLP_TIMEOUT_S=60` (el default del código es 15): el analizador de entidades procesa ~330 caracteres/s y los prompts largos de esos motores superaban los 15 s.

# Token interno Hub → motor de planillas (cadena larga aleatoria, ej. `openssl rand -hex 32`; lo genera el instalador).
TABULAR_INTERNAL_TOKEN=
# URL del motor de planillas para el Hub. Vacía = el Hub oculta la sección de planillas.
TABULAR_URL=http://tabular:8090
# Llave virtual de la cuenta de servicio `svc.tabular` (tool_type=servicio, can_act_on_behalf=true), creada con POST /api/v1/users + POST /api/v1/keys. Nunca la maestra.
TABULAR_ENGINE_VIRTUAL_KEY=
# Modelo real del catálogo para SQL y redacción (5/5 con planillas reales de Elea; 4o-mini 3/5).
TABULAR_MODEL=azure-gpt-5.4-mini
# URL del motor de presentaciones para el Hub. Vacía = el Hub oculta el botón de presentaciones.
PRESENTON_URL=http://presenton:80
# Llave virtual de la cuenta de servicio del motor de presentaciones (tool_type=servicio). Nunca la maestra. Con rpm 300 / tpm 2.000.000: manda varias diapositivas con imagen en paralelo.
PRESENTON_ENGINE_VIRTUAL_KEY=
# Modelo del motor de presentaciones. `azure-gpt-5.1-chat` no sirve (rate limit de Azure con 6 pedidos con imagen).
PRESENTON_MODEL=azure-gpt-5.4-mini

# ── Enmascarado forzado: lectura de PDF con topes (todas opcionales) ───────────────────
# Cuando la política de modelos exige enmascarar todo lo que sale hacia un modelo de otra región, los PDF con capa de texto se leen en un proceso aparte del motor, con tope de memoria, de tiempo y de expansión, se enmascaran y viajan como texto. Un PDF que no se puede leer (escaneado, protegido, corrupto o que supera un tope) no se envía: el pedido se bloquea con «no pudo protegerse». No hay lectura de imágenes (OCR) en esta entrega. Las variables son del motor (no del backend), todas opcionales y se leen en cada pedido; con un valor inválido rige el default de la línea.
# MASKING_PDF_MAX_PAGES=200               # páginas máximas por PDF
# MASKING_PDF_MAX_BYTES=20971520          # tamaño máximo del PDF, en bytes (20 MB)
# MASKING_PDF_MAX_MEMORY_MB=512           # memoria máxima del proceso de lectura (límite del sistema operativo)
# MASKING_PDF_TIMEOUT_S=20                # plazo por PDF, en segundos; al vencer el proceso se elimina (no analizable)
# MASKING_PDF_MAX_CONCURRENCY=2           # lecturas simultáneas por proceso del motor; las demás esperan
# MASKING_PDF_MAX_STREAM_BYTES=26214400   # tope de expansión de cada flujo comprimido del PDF (25 MB)
# MASKING_PDF_MAX_TEXT_CHARS=2000000      # caracteres máximos de texto extraído por PDF
# MASKING_PDF_MAX_PER_REQUEST=5           # PDF máximos por pedido; los que sobran cuentan como no analizables
# MASKING_PDF_REQUEST_DEADLINE_S=30       # plazo total por pedido para sus PDF, en segundos (incluye la espera de turno)
# MASKING_PDF_CACHE_ENTRIES=32            # PDF recientes recordados en memoria por su huella SHA-256 (nunca en disco); 0 apaga

# ── Marcadores de enmascarado estables por conversación (opcional) ──────────────────────
# Con una clave del servidor (≥ 32 caracteres, propia de la instalación, distinta de las demás; la genera el instalador: openssl rand -hex 32) el sufijo de los marcadores del enmascarado se deriva por conversación y por empresa, así el historial que se reenvía en cada turno sale idéntico y la caché del proveedor del modelo lo aprovecha. Sin ella los marcadores son aleatorios por pedido, como siempre. Nunca se usa como credencial de un modelo y nunca lleva un valor de ejemplo.
# MASKING_NONCE_KEY=

# ── Enmascarado forzado: caché de análisis por segmento (todas opcionales) ──────────────
# El enmascarado forzado analiza todo lo que sale hacia el modelo, y las herramientas reenvían el historial completo en cada turno; sin caché cada turno vuelve a pagar el análisis de lo que ya se analizó (un pedido típico de herramientas de código son ~93 000 caracteres). La caché recuerda, por segmento de texto, SOLO las detecciones (posición, tipo de entidad y puntaje): jamás el texto, el dato detectado ni los marcadores, que se generan en cada pedido. Vive en la memoria del proceso del motor (se pierde al reiniciar), no se comparte entre empresas y se invalida sola cuando cambia la configuración del análisis (región, nombres y entidades propias, URL del analizador). No cambia el resultado del enmascarado.
# MASKING_ANALYSIS_CACHE_ENABLED=true      # false la apaga (cada pedido analiza todo, como antes)
# MASKING_ANALYSIS_CACHE_MAX_ENTRIES=20000 # segmentos recordados (los menos usados se descartan primero)
# MASKING_ANALYSIS_CACHE_TTL_S=3600        # vida de cada entrada, en segundos
# MASKING_ANALYSIS_CACHE_SALT=             # texto libre: cambiarlo invalida toda la caché (úsese si se cambian los reconocedores del analizador sin cambiar nada más)
# Excepción opcional, APAGADA por defecto: no analizar el prompt de sistema o las definiciones de herramientas. Con la caché analizarlos cuesta una sola vez por texto y por empresa, y el prompt de sistema de las herramientas de código suele llevar datos personales reales (memoria de la persona, correo de la cuenta, estado del repositorio con nombres). Encenderla es una decisión explícita de la instalación; queda registrada en la auditoría (solo el nombre de lo exento) y el pedido no puede encenderla.
# MASKING_EXEMPT_SYSTEM_PROMPT=false        # true: el prompt de sistema viaja sin analizar
# MASKING_EXEMPT_TOOL_DEFINITIONS=false     # true: las definiciones de herramientas viajan sin analizar
# Imágenes bajo el enmascarado forzado. Una imagen no se puede analizar (no hay reconocimiento de texto): la instalación elige qué pasa con ella. `pass` (el valor por defecto) las deja salir tal cual hacia el modelo —las que adjunta la persona y las que devuelve una herramienta, como la captura con la que el agente revisa su trabajo—: no bloquean, no se reemplazan y la auditoría registra solo cuántas fueron y de qué tipo (`images_unmasked`), jamás el contenido; el texto se sigue enmascarando completo. `filter` es el comportamiento anterior: la imagen adjunta bloquea el pedido y la que devuelve una herramienta se reemplaza por una nota. Un valor desconocido se trata como `filter`. Un destino que no acepta imágenes las sigue rechazando con su error claro, con cualquiera de los dos valores. Lo decide la instalación: el pedido no puede cambiarlo.
# MASKING_IMAGES=pass                       # pass | filter
